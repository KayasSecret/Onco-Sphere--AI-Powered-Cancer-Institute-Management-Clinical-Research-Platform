# ─────────────────────────────────────────────────────────────────────────────
# Onco Sphere Frontend — Environment Variables Reference
# Copy this file to .env for local development:
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# Backend API Base URL
# For local development: http://localhost:8000
# For production (Render / Vercel / Netlify): https://your-backend-app-name.onrender.com
# (Do NOT include a trailing slash)
VITE_API_URL=http://localhost:8000

# Optional alias for backward compatibility (VITE_API_URL takes precedence)
VITE_API_BASE_URL=http://localhost:8000
