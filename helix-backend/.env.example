# ─────────────────────────────────────────────────────────────────────────────
# Onco Sphere Backend — Environment Variables Reference
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database Configuration ───────────────────────────────────────────────────
# Local MySQL:
#   DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/cancer_institute
#
# Production (Aiven Cloud MySQL):
#   Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>
#   Example: mysql+pymysql://avnadmin:AVNS_xxxx@mysql-3269ce57-onco-sphere.g.aivencloud.com:12345/defaultdb
#   NOTE: Do NOT append '?ssl-mode=REQUIRED' in the URL — PyMySQL rejects it.
#         SSL is automatically negotiated for remote connections using ca.pem.
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/cancer_institute

# Optional custom path to Aiven / Cloud MySQL CA certificate.
# If omitted or not set, the backend defaults to `ca.pem` located in the backend root directory.
MYSQL_SSL_CA=ca.pem

# ── JWT Authentication ────────────────────────────────────────────────────────
# Generate a strong 64-character secret in production using:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-this-to-a-long-random-secret-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Cloudinary (File Uploads) ─────────────────────────────────────────────────
# Create a free account at https://cloudinary.com
# Find these in your Cloudinary Dashboard under "API Keys"
# If left as placeholder, the backend safely falls back to local storage in static/uploads/
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── App Environment ───────────────────────────────────────────────────────────
APP_NAME=HELIX Oncology Intelligence Platform
APP_VERSION=1.0.0
ENVIRONMENT=development   # Set to 'production' on Render

# ── Email (Resend HTTPS API) ──────────────────────────────────────────────────
# Onco Sphere uses Resend (https://resend.com) to send transactional emails via HTTPS.
# This prevents SMTP port blocks (port 587/465) on Render Free tier.
#
# Setup steps:
#   1. Create an account at https://resend.com
#   2. Add and verify your domain under "Domains" (or test with onboarding@resend.dev)
#   3. Create an API key under "API Keys" (format: re_xxxxxxxxxxxx)
#   4. Set EMAIL_FROM to an address on your verified domain (e.g. noreply@yourdomain.com)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Onco Sphere
EMAIL_REPLY_TO=                         # Optional — leave blank to omit reply-to header
SUPER_ADMIN_EMAIL=admin@yourdomain.com  # Receives new researcher application alerts

# Frontend URL (used in email CTA links and CORS validation)
# For local development: http://localhost:5173
# For production: https://your-frontend-domain.com or https://onco-sphere.vercel.app
FRONTEND_URL=http://localhost:5173

# ── Email Subjects (Optional Customization) ───────────────────────────────────
# EMAIL_SUBJECT_REGISTRATION=Application Received — Onco Sphere Research Office
# EMAIL_SUBJECT_OTP=Your Onco Sphere Draft Resume Verification Code
# EMAIL_SUBJECT_APPROVED=Congratulations! Your Onco Sphere Access Has Been Approved
# EMAIL_SUBJECT_REJECTED=Update: Your Onco Sphere Access Request
# EMAIL_SUBJECT_PASSWORD_RESET=Password Reset Verification Code — Onco Sphere
# EMAIL_SUBJECT_ADMIN_NEW_APPLICATION=New Researcher Application Pending Review

# ── Email Retry Configuration (Optional) ──────────────────────────────────────
# EMAIL_MAX_RETRIES=3
# EMAIL_RETRY_BASE_DELAY=1.0
